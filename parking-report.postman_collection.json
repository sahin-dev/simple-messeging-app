{
  "info": {
    "_postman_id": "parking-report-module-collection",
    "name": "Parking Report Module",
    "description": "Complete Postman collection for the Parking Report module. Covers parking reports (create, read, update, deactivate, delete), nearby search, parking spots, and the notification credit system.\n\nAll endpoints require Bearer token authentication. Set the `auth_token` and `base_url` collection variables before running.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{auth_token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Parking Reports",
      "description": "CRUD operations for parking availability reports submitted by users.",
      "item": [
        {
          "name": "Create Parking Report",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"latitude\": 23.8103,\n  \"longitude\": 90.4125,\n  \"parking_cost\": \"FREE\",\n  \"electric_charging\": false,\n  \"disabled_facility\": true,\n  \"disabled_facility_location\": \"LEFT\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/parking-report",
              "host": ["{{base_url}}"],
              "path": ["parking-report"]
            },
            "description": "Submit a new parking availability report. Earns the user 1 notification credit. Triggers a push notification to nearby users (within their configured radius).\n\n**parking_cost**: `FREE` | `PAID`\n**disabled_facility_location**: `TOP` | `RIGHT` | `LEFT` | `NONE` | `ALL` (optional)\n\nThe report expires after 10 minutes automatically."
          },
          "response": []
        },
        {
          "name": "Get All Parking Reports",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/parking-report?page=1&limit=10&isActive=true",
              "host": ["{{base_url}}"],
              "path": ["parking-report"],
              "query": [
                {
                  "key": "page",
                  "value": "1",
                  "description": "Page number (default: 1)"
                },
                {
                  "key": "limit",
                  "value": "10",
                  "description": "Results per page (default: 10)"
                },
                {
                  "key": "isActive",
                  "value": "true",
                  "description": "Filter by active status (default: true)"
                }
              ]
            },
            "description": "Fetch all parking reports with pagination. Only non-expired reports (created within the last 10 minutes) are returned in the final list."
          },
          "response": []
        },
        {
          "name": "Get Parking Report By ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/parking-report/{{report_id}}",
              "host": ["{{base_url}}"],
              "path": ["parking-report", "{{report_id}}"]
            },
            "description": "Fetch a single parking report by its Mongo ID. Returns 404 if the report has expired or does not exist."
          },
          "response": []
        },
        {
          "name": "Get Nearby Parking Reports",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/parking-report/nearby?latitude=23.8103&longitude=90.4125&radius=5&page=1&limit=10",
              "host": ["{{base_url}}"],
              "path": ["parking-report", "nearby"],
              "query": [
                {
                  "key": "latitude",
                  "value": "23.8103",
                  "description": "Your current latitude (required)"
                },
                {
                  "key": "longitude",
                  "value": "90.4125",
                  "description": "Your current longitude (required)"
                },
                {
                  "key": "radius",
                  "value": "5",
                  "description": "Search radius in km (default: 5)"
                },
                {
                  "key": "page",
                  "value": "1",
                  "description": "Page number (default: 1)"
                },
                {
                  "key": "limit",
                  "value": "10",
                  "description": "Results per page (default: 10)"
                }
              ]
            },
            "description": "Fetch active, non-expired parking reports near a given GPS coordinate. Uses a bounding-box approximation (~111 km per degree of latitude)."
          },
          "response": []
        },
        {
          "name": "Get Parking Reports By User ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/parking-report/user/{{target_user_id}}?page=1&limit=10",
              "host": ["{{base_url}}"],
              "path": ["parking-report", "user", "{{target_user_id}}"],
              "query": [
                {
                  "key": "page",
                  "value": "1",
                  "description": "Page number (default: 1)"
                },
                {
                  "key": "limit",
                  "value": "10",
                  "description": "Results per page (default: 10)"
                }
              ]
            },
            "description": "Fetch active (non-expired) parking reports submitted by a specific user."
          },
          "response": []
        },
        {
          "name": "Update Parking Report",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"parking_cost\": \"PAID\",\n  \"electric_charging\": true,\n  \"disabled_facility\": false,\n  \"disabled_facility_location\": \"NONE\",\n  \"latitude\": 23.8103,\n  \"longitude\": 90.4125,\n  \"is_active\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/parking-report/{{report_id}}",
              "host": ["{{base_url}}"],
              "path": ["parking-report", "{{report_id}}"]
            },
            "description": "Update a parking report. Only the owner of the report can update it. All fields are optional. Returns 404 if the report is expired or not found."
          },
          "response": []
        },
        {
          "name": "Deactivate Parking Report",
          "request": {
            "method": "PUT",
            "header": [],
            "url": {
              "raw": "{{base_url}}/parking-report/{{report_id}}/deactivate",
              "host": ["{{base_url}}"],
              "path": ["parking-report", "{{report_id}}", "deactivate"]
            },
            "description": "Mark a parking report as inactive (spot is no longer available). Only the owner can deactivate their report. Returns 404 if expired or not found."
          },
          "response": []
        },
        {
          "name": "Delete Parking Report",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{base_url}}/parking-report/{{report_id}}",
              "host": ["{{base_url}}"],
              "path": ["parking-report", "{{report_id}}"]
            },
            "description": "Permanently delete a parking report. Only the owner of the report can delete it."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Parking Spots",
      "description": "Manage permanent/known parking spots (distinct from user-submitted parking reports).",
      "item": [
        {
          "name": "Create Parking Spot",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"latitude\": 23.8103,\n  \"longitude\": 90.4125,\n  \"parking_cost\": \"PAID\",\n  \"electric_charging\": true,\n  \"disabled_facility\": true,\n  \"disabled_facility_location\": \"RIGHT\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/parking-report/spot",
              "host": ["{{base_url}}"],
              "path": ["parking-report", "spot"]
            },
            "description": "Create a known permanent parking spot.\n\n**parking_cost**: `FREE` | `PAID`\n**disabled_facility_location**: `TOP` | `RIGHT` | `LEFT` | `NONE` | `ALL` (optional)"
          },
          "response": []
        },
        {
          "name": "Get All Parking Spots",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/parking-report/spot?page=1&limit=10",
              "host": ["{{base_url}}"],
              "path": ["parking-report", "spot"],
              "query": [
                {
                  "key": "page",
                  "value": "1",
                  "description": "Page number (default: 1)"
                },
                {
                  "key": "limit",
                  "value": "10",
                  "description": "Results per page (default: 10)"
                }
              ]
            },
            "description": "Fetch all parking spots with pagination."
          },
          "response": []
        },
        {
          "name": "Get Parking Spot By ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/parking-report/spot/{{spot_id}}",
              "host": ["{{base_url}}"],
              "path": ["parking-report", "spot", "{{spot_id}}"]
            },
            "description": "Fetch a single parking spot by its Mongo ID. Returns 404 if not found."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Notification Credits",
      "description": "Parking notification credit system. Users earn 1 credit per parking report submitted and start with 1 free notification. Credits are consumed when they receive parking notifications from others.",
      "item": [
        {
          "name": "Get My Credit Status",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/parking-report/credit/status",
              "host": ["{{base_url}}"],
              "path": ["parking-report", "credit", "status"]
            },
            "description": "Get the authenticated user's parking notification credit balance and submission stats.\n\nReturns:\n- `parking_notifications_available` — credits remaining\n- `parking_reports_submitted` — total reports submitted\n- `notifications_received` — estimated total notifications received"
          },
          "response": []
        },
        {
          "name": "Get My Credit History",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/parking-report/credit/history?page=1&limit=10",
              "host": ["{{base_url}}"],
              "path": ["parking-report", "credit", "history"],
              "query": [
                {
                  "key": "page",
                  "value": "1",
                  "description": "Page number (default: 1)"
                },
                {
                  "key": "limit",
                  "value": "10",
                  "description": "Results per page (default: 10)"
                }
              ]
            },
            "description": "Get the paginated transaction history of parking notification credits for the authenticated user. Each entry shows whether the credit was `EARNED` (report submitted) or `CONSUMED` (notification received), the amount, and running balance."
          },
          "response": []
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://10.10.28.200:8003",
      "type": "string",
      "description": "Base URL of the API server"
    },
    {
      "key": "auth_token",
      "value": "your-jwt-token-here",
      "type": "string",
      "description": "Bearer token from login response"
    },
    {
      "key": "report_id",
      "value": "65c697843818e9ba1332a688",
      "type": "string",
      "description": "Mongo ObjectId of a parking report"
    },
    {
      "key": "spot_id",
      "value": "65c697843818e9ba1332a799",
      "type": "string",
      "description": "Mongo ObjectId of a parking spot"
    },
    {
      "key": "target_user_id",
      "value": "65c697843818e9ba1332a700",
      "type": "string",
      "description": "Mongo ObjectId of a user whose reports you want to fetch"
    }
  ]
}
