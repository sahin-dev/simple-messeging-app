{
  "info": {
    "name": "PLATEChatter - ParkRelay Module",
    "description": "Full endpoint coverage of the ParkRelay module: parking mode, handoffs (release/accept a spot), saved parking, paid parking prompts, parking sessions, parking areas, ratings, and admin parking-area management.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "ParkRelay - Parking Mode",
      "item": [
        {
          "name": "Start Searching",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/park-relay/parking-mode/searching",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"latitude\": 23.7806,\n  \"longitude\": 90.4074,\n  \"accuracy\": 5\n}"
            }
          }
        },
        {
          "name": "Mark Parked",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/park-relay/parking-mode/parked",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"latitude\": 23.7806,\n  \"longitude\": 90.4074,\n  \"accuracy\": 5\n}"
            }
          }
        },
        {
          "name": "Set Idle",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/park-relay/parking-mode/idle"
          }
        },
        {
          "name": "Get My Parking Mode",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/park-relay/parking-mode/me"
          }
        }
      ]
    },
    {
      "name": "ParkRelay - Handoffs",
      "item": [
        {
          "name": "Create Handoff (Exit Parking)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/park-relay/handoffs",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"latitude\": 23.7806,\n  \"longitude\": 90.4074,\n  \"spotId\": \"{{parkingAreaId}}\"\n}"
            }
          }
        },
        {
          "name": "Accept Handoff",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/park-relay/handoffs/{{handoffId}}/accept"
          }
        },
        {
          "name": "Accept Handoff And Park",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/park-relay/handoffs/{{handoffId}}/accept-and-park",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"note\": \"Parked near entrance\",\n  \"photoUrl\": \"\",\n  \"accuracy\": 5,\n  \"confidence\": 0.9\n}"
            }
          }
        },
        {
          "name": "Mark Handoff Occupied",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/park-relay/handoffs/{{handoffId}}/occupied"
          }
        },
        {
          "name": "Mark Handoff Found",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/park-relay/handoffs/{{handoffId}}/found"
          }
        },
        {
          "name": "Cancel Handoff",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/park-relay/handoffs/{{handoffId}}/cancel"
          }
        },
        {
          "name": "Get Nearby Handoffs",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/park-relay/handoffs/nearby?latitude={{latitude}}&longitude={{longitude}}&radiusMeters={{radiusMeters}}"
          }
        },
        {
          "name": "Get Handoff By Id",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/park-relay/handoffs/{{handoffId}}?latitude={{latitude}}&longitude={{longitude}}"
          }
        }
      ]
    },
    {
      "name": "ParkRelay - Saved Parking",
