                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/park-relay/paid-parking-prompt/{{promptId}}/answer",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"parkingType\": \"PAID\",\n  \"durationMin\": 60\n}"
            }
          }
        },
        {
          "name": "Dismiss Paid Parking Prompt",
          "request": {
            "method": "POST",
