                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/park-relay/saved-parking",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"latitude\": 23.7806,\n  \"longitude\": 90.4074,\n  \"accuracy\": 5,\n  \"confidence\": 0.9,\n  \"source\": \"MANUAL\",\n  \"spotId\": \"{{parkingAreaId}}\",\n  \"parkingType\": \"FREE\",\n  \"note\": \"Near the main gate\",\n  \"photoUrl\": \"\"\n}"
            }
          }
        },
        {
          "name": "Process Parked Event",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/park-relay/parked-event",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"latitude\": 23.7806,\n  \"longitude\": 90.4074,\n  \"accuracy\": 5,\n  \"confidence\": 0.9,\n  \"source\": \"AUTO\",\n  \"spotId\": \"{{parkingAreaId}}\",\n  \"parkingType\": \"PAID\",\n  \"durationMin\": 60,\n  \"createPaidParkingPrompt\": true\n}"
            }
          }
        },
        {
          "name": "Get My Saved Parking",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/park-relay/saved-parking/me"
          }
        },
        {
          "name": "Get Saved Parking History",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/park-relay/saved-parking/history?page=1&limit=20"
          }
        },
        {
          "name": "Delete Saved Parking Location",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/park-relay/saved-parking/me"
          }
        }
      ]
    },
    {
      "name": "ParkRelay - Paid Parking Prompt",
      "item": [
        {
          "name": "Get Pending Paid Parking Prompt",
          "request": {
