// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client"
  output        = "../generated/prisma"
  moduleFormat  = "cjs"
  binaryTargets = ["native", "rhel-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id     String  @id @default(auto()) @map("_id") @db.ObjectId
  avatar String?
  fcm_token String?

  email      String @unique
  name       String?
  licence_id String?
  nick_name  String @unique
  password   String
  is_more_options_accepted   Boolean  @default(false)
  designation String?
  is_blocked  Boolean  @default(false)
  is_deleted  Boolean  @default(false)
  email_verified Boolean @default(false)
  account_type AccountType @default(FREE)
  qr_code String?

  otp                    String?
  otp_expires            DateTime?
  otp_verification_token String?

  role UserRole @default(USER)

  chatRooms_user1 ChatRoom[]  @relation("user1")
  chatRooms_user2 ChatRoom[]  @relation("user2")
  blockLists      BlockList[] @relation("user")
  blockListsBy    BlockList[] @relation("blocked_user")
  sentMessages     Chat[] @relation("sender")
  receivedMessages Chat[] @relation("receiver")

  groupChatRooms GroupChatRoomMember[]
  groupChats     GroupChat[] @relation("sender")
  userRatingsGiven UserRating[] @relation("rater")
  userRatingsReceived UserRating[] @relation("ratee")
  parkingReports ParkingReport[]
  documents UserDocument[]
  
  notificationEvents NotificationEvent[]
  notificationPreference NotificationPreference?
  userLocation UserLocation?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model ChatRoom {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  is_deleted Boolean @default(false)
  user1_id String @db.ObjectId
  user2_id String @db.ObjectId

  user1 User @relation("user1", fields: [user1_id], references: [id], onDelete: Cascade)
  user2 User @relation("user2", fields: [user2_id], references: [id], onDelete: Cascade)

  chats Chat[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([user1_id, user2_id])
  @@map("chat_rooms")
}

model GroupChatRoom {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  name String
  image String?
  is_deleted Boolean @default(false)
  group_members_count Int @default(0)
  members GroupChatRoomMember[]

  chats GroupChat[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("group_chat_rooms")
}

model GroupChatRoomMember {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  groupChatRoom_id String @db.ObjectId
  user_id String @db.ObjectId
  last_read_message_id String? @db.ObjectId
  group_role GroupRole @default(GROUP_MEMBER)

  groupChatRoom GroupChatRoom @relation(fields: [groupChatRoom_id], references: [id], onDelete: Cascade)
  user          User          @relation(fields: [user_id], references: [id], onDelete: Cascade)
 
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([groupChatRoom_id, user_id])
  @@map("group_chat_room_members")
}

model GroupChat {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  groupChatRoom_id String @db.ObjectId
  sender_id String @db.ObjectId
  message String
  type MessageType @default(TEXT)

  groupChatRoom GroupChatRoom @relation(fields: [groupChatRoom_id], references: [id], onDelete: Cascade)
  sender User @relation(fields: [sender_id], references: [id], onDelete: Cascade, name: "sender")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("group_chats")
}

model Chat {
  id           String      @id @default(auto()) @map("_id") @db.ObjectId
  chatRoom_id  String      @db.ObjectId
  sender_id    String      @db.ObjectId
  receiver_id  String      @db.ObjectId
  message      String
  type         MessageType @default(TEXT)
  is_read      Boolean     @default(false)
  is_delivered Boolean     @default(false)

  chatRoom ChatRoom @relation(fields: [chatRoom_id], references: [id], onDelete: Cascade)
  sender   User     @relation("sender", fields: [sender_id], references: [id], onDelete: Cascade)
  receiver User     @relation("receiver", fields: [receiver_id], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("chats")
}

model PresetMessage {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  message_en String
  message_it String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("preset_messages")
}

model UsefullNumber {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  title String
  phone String
  location location
  geolocation geolocation?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@map("useful_numbers")
}

type location {
  latitude Float
  longitude Float
}

type geolocation {
  type String
  coordinates Float[]
}


model UserRating {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  rater_id String @db.ObjectId
  ratee_id String @db.ObjectId
  rating Int
  status RatingStatus @default(PENDING)

  rater User @relation("rater", fields: [rater_id], references: [id], onDelete: Cascade)
  ratee User @relation("ratee", fields: [ratee_id], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([rater_id, ratee_id])
  @@map("user_ratings")
}



model BlockList {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  user_id         String @db.ObjectId
  blocked_user_id String @db.ObjectId

  user         User @relation("user", fields: [user_id], references: [id], onDelete: Cascade)
  blocked_user User @relation("blocked_user", fields: [blocked_user_id], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([user_id, blocked_user_id])
  @@map("block_list")
}

model SitePolicy {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  type PolicyType

  content String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("site_policy")
}

enum MessageType {
  TEXT
}

model Point {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  name String
  description String?
  latitude Float
  longitude Float

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("points")
}

model BlackListedWord {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  word String @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("blacklisted_words")
}

model ParkingReport {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  
  user_id String @db.ObjectId
  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)
  
  latitude Float
  longitude Float
  parking_cost ParkingCost
  electric_charging Boolean @default(false)
  disabled_facility Boolean @default(false)
  disabled_facility_location DisabledFacilityLocation?
  is_active Boolean @default(true)
  expiresAt DateTime
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@map("parking_reports")
}

enum JobType {
  SendWelcomeEmail
}

enum UserRole {
  USER
  ADMIN
}

enum PolicyType {
  PrivacyPolicy
  Terms
  More
}

enum GroupRole {
  GROUP_ADMIN
  GROUP_MEMBER
}

enum RatingStatus {
  PUBLISHED
  REJECTED
  PENDING
}

enum AccountType {
  FREE
  PREMIUM
}

enum ParkingType {
  SPOT
  STREET
  GARAGE
  LOT
}

enum ParkingCost {
  FREE
  PAID
}

enum DisabledFacilityLocation {
  TOP
  RIGHT
  LEFT
  NONE
  ALL
}

enum NotificationEventType {
  PARKING_AVAILABLE
  PARKING_NEARBY
  CHAT_MESSAGE
  CHAT_DELIVERED
  CHAT_READ
  RATING_RECEIVED
  GROUP_CHAT_MESSAGE
  GROUP_CHAT_ADDED
  GROUP_CHAT_REMOVED
  SYSTEM_NOTIFICATION
  USER_MENTION
  PARKING_EXPIRING_SOON
  DOCUMENT_EXPIRING_SOON
  DOCUMENT_EXPIRED
}

model NotificationEvent {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  eventType NotificationEventType
  title     String
  message   String
  payload   String?
  
  isRead    Boolean  @default(false)
  sentAt    DateTime @default(now())
  readAt    DateTime?
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@index([userId])
  @@index([eventType])
  @@index([isRead])
  @@index([createdAt])
  @@map("notification_events")
}

model NotificationPreference {
  id                      String   @id @default(auto()) @map("_id") @db.ObjectId
  userId                  String   @unique @db.ObjectId
  user                    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  parkingNotifications    Boolean  @default(true)
  chatNotifications       Boolean  @default(true)
  ratingNotifications     Boolean  @default(true)
  groupChatNotifications  Boolean  @default(true)
  systemNotifications     Boolean  @default(true)
  
  notificationRadius      Int      @default(200)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@map("notification_preferences")
}

model UserLocation {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @unique @db.ObjectId
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  latitude  Float
  longitude Float
  accuracy  Float?
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@map("user_locations")
}

model UserDocument{
  id String @id @default(auto()) @map("_id") @db.ObjectId
  user_id String @db.ObjectId
  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)
  unique_id String @unique
  expiry_date DateTime
  document_type DocumentType
  document_url String
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@map("user_documents")
}

enum DocumentType {
  LICENSE
  INSURANCE
  TAX
}