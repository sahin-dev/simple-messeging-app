{
  "info": {
    "name": "PLATEChatter New Features - ParkRelay, Messaging Requests, Voice, E2EE",
    "_postman_id": "platechatter-new-features-parkrelay-messaging",
    "description": "Focused collection for newly added and modified endpoints on the parkrelay branch. Set baseUrl, token, adminToken, and ID variables before running.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000", "type": "string" },
    { "key": "token", "value": "USER_JWT_TOKEN_HERE", "type": "string" },
    { "key": "adminToken", "value": "ADMIN_JWT_TOKEN_HERE", "type": "string" },
    { "key": "receiverId", "value": "RECEIVER_USER_ID", "type": "string" },
    { "key": "targetUserId", "value": "TARGET_USER_ID_FOR_KEYS", "type": "string" },
    { "key": "handoffId", "value": "PARKING_HANDOFF_ID", "type": "string" },
    { "key": "parkingSessionId", "value": "PARKING_SESSION_ID", "type": "string" },
    { "key": "parkingAreaId", "value": "PARKING_AREA_ID", "type": "string" },
    { "key": "messageRequestId", "value": "MESSAGE_REQUEST_ID", "type": "string" },
    { "key": "presetMessageId", "value": "PRESET_MESSAGE_ID", "type": "string" },
    { "key": "deviceId", "value": "ios-device-001", "type": "string" }
  ],
  "item": [
    {
      "name": "ParkRelay - Parking Mode",
      "item": [
        {
          "name": "Start Searching",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/park-relay/parking-mode/searching",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"latitude\": 23.7806,\n  \"longitude\": 90.4074,\n  \"accuracy\": 8,\n  \"confidence\": 0.82\n}"
            }
          },
          "response": []
        },
        {
          "name": "Mark Parked",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/park-relay/parking-mode/parked",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"latitude\": 23.7806,\n  \"longitude\": 90.4074,\n  \"accuracy\": 8,\n  \"confidence\": 0.9\n}"
            }
          },
          "response": []
        },
        {
          "name": "Set Idle",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/park-relay/parking-mode/idle"
          },
          "response": []
        },
        {
          "name": "Get My Parking Mode",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/park-relay/parking-mode/me"
          },
          "response": []
        }
      ]
    },
    {
      "name": "ParkRelay - Handoffs",
      "item": [
        {
          "name": "Create Handoff",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/park-relay/handoffs",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"latitude\": 23.7806,\n  \"longitude\": 90.4074\n}"
            },
            "description": "User 1/Releaser starts a 5-minute handoff. This targets active seekers within 300m without touching the old credit system."
          },
          "response": []
        },
        {
          "name": "Accept Handoff",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/park-relay/handoffs/{{handoffId}}/accept",
            "description": "User 2/Seeker accepts the handoff. First successful accept wins."
          },
          "response": []
        },
        {
          "name": "Cancel Handoff",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/park-relay/handoffs/{{handoffId}}/cancel"
          },
          "response": []
        },
        {
          "name": "Mark Handoff Occupied",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/park-relay/handoffs/{{handoffId}}/occupied"
          },
          "response": []
        },
        {
          "name": "Get Nearby Handoffs",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/park-relay/handoffs/nearby?latitude=23.7806&longitude=90.4074&radiusMeters=300",
              "host": ["{{baseUrl}}"],
              "path": ["park-relay", "handoffs", "nearby"],
              "query": [
                { "key": "latitude", "value": "23.7806" },
                { "key": "longitude", "value": "90.4074" },
                { "key": "radiusMeters", "value": "300" }
              ]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "SaveParK - Saved Parking",
      "item": [
        {
          "name": "Save Parking Location",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/park-relay/saved-parking",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"latitude\": 23.7806,\n  \"longitude\": 90.4074,\n  \"accuracy\": 10,\n  \"confidence\": 0.91,\n  \"source\": \"AUTO\"\n}"
            }
          },
          "response": []
        },
        {
          "name": "Get Saved Parking Location",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/park-relay/saved-parking/me"
          },
          "response": []
        },
        {
          "name": "Delete Saved Parking Location",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/park-relay/saved-parking/me"
          },
          "response": []
        }
      ]
    },
    {
      "name": "Parktime - Parking Sessions",
      "item": [
        {
          "name": "Create Paid Parking Session",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/park-relay/parking-sessions",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"latitude\": 23.7806,\n  \"longitude\": 90.4074,\n  \"costType\": \"PAID\",\n  \"durationMin\": 30\n}"
            }
          },
          "response": []
        },
        {
          "name": "Create Free Parking Session",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/park-relay/parking-sessions",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"latitude\": 23.7806,\n  \"longitude\": 90.4074,\n  \"costType\": \"FREE\"\n}"
            }
          },
          "response": []
        },
        {
          "name": "Get Active Parking Session",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/park-relay/parking-sessions/me/active"
          },
          "response": []
        },
        {
          "name": "Leave Parking Session",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/park-relay/parking-sessions/{{parkingSessionId}}/leave"
          },
          "response": []
        },
        {
          "name": "Dispatch Expiry Warnings (Admin)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": "{{baseUrl}}/park-relay/parking-sessions/dispatch-expiry-warnings"
          },
          "response": []
        }
      ]
    },
    {
      "name": "Admin Map - Parking Areas",
      "item": [
        {
          "name": "Create Parking Area (Admin)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/park-relay/admin/parking-areas",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Central Paid Parking\",\n  \"description\": \"Admin drawn polygon around paid spots\",\n  \"centerLat\": 23.7806,\n  \"centerLng\": 90.4074,\n  \"parkingCost\": \"PAID\",\n  \"polygon\": [\n    { \"latitude\": 23.7801, \"longitude\": 90.4069 },\n    { \"latitude\": 23.7811, \"longitude\": 90.4069 },\n    { \"latitude\": 23.7811, \"longitude\": 90.4079 },\n    { \"latitude\": 23.7801, \"longitude\": 90.4079 }\n  ]\n}"
            }
          },
          "response": []
        },
        {
          "name": "List Parking Areas (Admin)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/park-relay/admin/parking-areas?page=1&limit=20",
              "host": ["{{baseUrl}}"],
              "path": ["park-relay", "admin", "parking-areas"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "20" }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Update Parking Area (Admin)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/park-relay/admin/parking-areas/{{parkingAreaId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Central Parking Updated\",\n  \"parkingCost\": \"FREE\",\n  \"isActive\": true\n}"
            }
          },
          "response": []
        },
        {
          "name": "Delete Parking Area (Admin)",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": "{{baseUrl}}/park-relay/admin/parking-areas/{{parkingAreaId}}"
          },
          "response": []
        },
        {
          "name": "Get Nearby Parking Areas",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/park-relay/parking-areas/nearby?latitude=23.7806&longitude=90.4074&radiusMeters=1000",
              "host": ["{{baseUrl}}"],
              "path": ["park-relay", "parking-areas", "nearby"],
              "query": [
                { "key": "latitude", "value": "23.7806" },
                { "key": "longitude", "value": "90.4074" },
                { "key": "radiusMeters", "value": "1000" }
              ]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Messaging - Requests",
      "item": [
        {
          "name": "Create Message Request",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/chat/message-requests",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"receiverId\": \"{{receiverId}}\",\n  \"firstMessage\": \"Hi, can I message you?\"\n}"
            }
          },
          "response": []
        },
        {
          "name": "Get Message Request Inbox",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/chat/message-requests/inbox?page=1&limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["chat", "message-requests", "inbox"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Accept Message Request",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/chat/message-requests/{{messageRequestId}}/accept"
          },
          "response": []
        },
        {
          "name": "Decline Message Request",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/chat/message-requests/{{messageRequestId}}/decline"
          },
          "response": []
        }
      ]
    },
    {
      "name": "Messaging - Voice and E2EE",
      "item": [
        {
          "name": "Send Voice Message",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/chat/message/voice",
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "receiver_id", "value": "{{receiverId}}", "type": "text" },
                { "key": "message", "value": "Voice note", "type": "text" },
                { "key": "durationSeconds", "value": "12", "type": "text" },
                { "key": "encryptionType", "value": "x25519-xsalsa20-poly1305", "type": "text", "disabled": true },
                { "key": "encryptionVersion", "value": "1", "type": "text", "disabled": true },
                { "key": "senderKeyId", "value": "SENDER_KEY_ID", "type": "text", "disabled": true },
                { "key": "receiverKeyId", "value": "RECEIVER_KEY_ID", "type": "text", "disabled": true },
                { "key": "nonce", "value": "BASE64_NONCE", "type": "text", "disabled": true },
                { "key": "file", "type": "file", "src": "" }
              ]
            },
            "description": "Requires an accepted/existing chat room. Upload an audio file in the file field."
          },
          "response": []
        },
        {
          "name": "Register E2EE Device Key",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/chat/e2ee/device-key",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"deviceId\": \"{{deviceId}}\",\n  \"publicKey\": \"BASE64_PUBLIC_KEY_FROM_CLIENT\"\n}"
            }
          },
          "response": []
        },
        {
          "name": "Get User E2EE Device Keys",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/chat/e2ee/users/{{targetUserId}}/keys"
          },
          "response": []
        },
        {
          "name": "Deactivate My Device Key",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/chat/e2ee/device-key/{{deviceId}}"
          },
          "response": []
        }
      ]
    },
    {
      "name": "Modified Preset Messages",
      "item": [
        {
          "name": "Create Classic Preset Message",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/preset-message",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"message_en\": \"Can I send you a message?\",\n  \"message_it\": \"Posso inviarti un messaggio?\",\n  \"type\": \"CLASSIC\",\n  \"isActive\": true\n}"
            }
          },
          "response": []
        },
        {
          "name": "Create Alert Preset Message",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/preset-message",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"message_en\": \"Emergency: your car may be blocking traffic.\",\n  \"message_it\": \"Emergenza: la tua auto potrebbe bloccare il traffico.\",\n  \"type\": \"ALERT\",\n  \"isActive\": true\n}"
            }
          },
          "response": []
        },
        {
          "name": "Update Preset Message Type/Active",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/preset-message/{{presetMessageId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"message_en\": \"Updated preset text\",\n  \"message_it\": \"Testo predefinito aggiornato\",\n  \"type\": \"ALERT\",\n  \"isActive\": true\n}"
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Socket Payload Notes - Modified Message Event",
      "item": [
        {
          "name": "Socket: message event payload examples",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}",
            "description": "Socket.IO event name: message\n\nClassic first-contact payload creates a pending message request:\n{\n  \"receiver_id\": \"{{receiverId}}\",\n  \"message\": \"Hello, can I message you?\"\n}\n\nAlert preset payload bypasses message request and delivers directly:\n{\n  \"receiver_id\": \"{{receiverId}}\",\n  \"presetMessageId\": \"{{presetMessageId}}\"\n}\n\nEncrypted message payload stores ciphertext opaquely:\n{\n  \"receiver_id\": \"{{receiverId}}\",\n  \"message\": \"BASE64_CIPHERTEXT\",\n  \"encryptionType\": \"x25519-xsalsa20-poly1305\",\n  \"encryptionVersion\": 1,\n  \"senderKeyId\": \"SENDER_KEY_ID\",\n  \"receiverKeyId\": \"RECEIVER_KEY_ID\",\n  \"nonce\": \"BASE64_NONCE\"\n}\n\nNew emitted events: message-request, message-request-sent, message-request-accepted."
          },
          "response": []
        }
      ]
    }
  ]
}
